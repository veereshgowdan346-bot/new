# ==============================================================================
# CHINTU AI TRADING SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env': cp .env.example .env
# 2. Fill in your authentic credentials below.
# 3. NEVER commit your '.env' file to version control.
# 4. Keep execution_mode set to 'PAPER' until feed and execution are verified.
# ==============================================================================

# Angel One SmartAPI Credentials (Required for Live Exchange Feed)
ANGEL_API_KEY=
ANGEL_CLIENT_ID=
ANGEL_PIN=
ANGEL_TOTP_SECRET=

# System Execution Engine Mode (Default: PAPER, Strictly enforced fail-closed)
CHINTU_EXECUTION_MODE=PAPER

# Telegram Bot Commander (Optional for real-time trade & risk alerts)
CHINTU_TELEGRAM_BOT_TOKEN=
CHINTU_TELEGRAM_CHAT_ID=

# Gemini Quantitative Reasoning AI (Optional)
GEMINI_API_KEY=

# Allowed CORS Origins (Comma-separated)
CHINTU_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

